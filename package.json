{
  "name": "openclawd",
  "version": "1.0.0",
  "description": "Autonomous meme token scout system",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "dashboard": "node --env-file=.env src/dashboard/server.js",
    "dashboard:ui": "cd dashboard-ui && npm run dev",
    "dashboard:build": "cd dashboard-ui && npm run build"
  },
  "keywords": [
    "meme",
    "token",
    "scout",
    "crypto",
    "autonomous"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "express": "^5.2.1",
    "ws": "^8.19.0"
  }
}
